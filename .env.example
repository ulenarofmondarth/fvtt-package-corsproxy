# Server Configuration
PORT=8080

# Request Limits
MAX_REQUEST_SIZE=10485760           # 10MB in bytes (10 * 1024 * 1024)
REQUEST_TIMEOUT=30s                 # Use Go duration format: 30s, 1m, 1m30s
MAX_REDIRECTS=10

# CORS Configuration
ALLOWED_ORIGINS=*                   # Use * for all origins, or comma-separated: https://example.com,https://app.example.com

# Security - Host Filtering (comma-separated)
ALLOWED_HOSTS=                      # If set, only these hosts allowed (e.g., api.github.com,api.example.com)
BLOCKED_HOSTS=                      # Block specific hosts (e.g., localhost,127.0.0.1,internal.company.com)
ALLOW_PRIVATE_NETWORKS=false        # Allow proxying to loopback/private/link-local addresses (SSRF risk — only for trusted internal deployments)

# Rate Limiting
RATE_LIMIT_PER_MINUTE=0             # 0 = disabled, set to number (e.g., 60 for 60 req/min per IP)
TRUST_PROXY_HEADERS=false           # Only set true behind a reverse proxy/platform that actually sets X-Forwarded-For — otherwise the rate limit above is spoofable

# API Key Authentication (optional)
REQUIRE_API_KEY=false               # Require a valid key from API_KEYS on every proxied request
API_KEYS=                           # Comma-separated list of accepted keys (e.g., key-for-team-a,key-for-team-b)

# Daily Request Ceiling (kill switch)
DAILY_REQUEST_LIMIT=0               # 0 = disabled. Global (not per-IP) request cap per rolling 24h window

# Response cache (shared by every client, in memory)
CACHE_TTL=0                         # 0 = disabled. How long an answer is served before it is fetched or revalidated again (e.g. 1h)
CACHE_NEGATIVE_TTL=5m               # The same for 404 and 410 answers
CACHE_MAX_STALE=24h                 # How long past CACHE_TTL an answer is still served when the upstream refuses (403/429/5xx) or fails
CACHE_MAX_BYTES=67108864            # 64MB: the most memory the cache uses
CACHE_MAX_ENTRY_BYTES=2097152       # 2MB: the largest answer kept

# URL allowlist (optional): narrows ALLOWED_HOSTS to host/path patterns, comma-separated
ALLOWED_URLS=                       # e.g. api.github.com/repos/*/*/releases,*.githubusercontent.com/** (empty = any URL on an allowed host)
URL_ALLOWLIST_MODE=enforce          # enforce refuses unlisted URLs; report only logs them, to build the list
LOG_UNLISTED_URLS=true              # Log each unlisted URL, refused or reported
CLIENT_VERSION_HEADER=              # A request header logged with unlisted URLs, never forwarded (e.g. X-EMMA-Version)

# GitHub API token (optional): a fine-grained token with "Public repositories" read-only access
GITHUB_TOKEN=                       # Sent to api.github.com only; raises GitHub's limit from 60 to 5,000 requests an hour

# Logging
VERBOSE_LOGGING=false               # Set to true for detailed request logs

# Examples for production:
# RATE_LIMIT_PER_MINUTE=100
# TRUST_PROXY_HEADERS=true
# ALLOWED_HOSTS=api.github.com,api.stripe.com
# BLOCKED_HOSTS=localhost,127.0.0.1,192.168.0.0
# MAX_REQUEST_SIZE=5242880           # 5MB
# REQUEST_TIMEOUT=15s
# VERBOSE_LOGGING=true
# REQUIRE_API_KEY=true
# API_KEYS=key-for-team-a,key-for-team-b
# DAILY_REQUEST_LIMIT=100000
# CACHE_TTL=1h
